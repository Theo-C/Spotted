# Copie ce fichier vers .env et remplis les valeurs.
# Le .env est gitignoré — ne JAMAIS le commit.
# Toutes ces clés sont "publishable" (côté client) — protégées par RLS Supabase + quota Mapbox.
# Ne jamais y mettre une service_role Supabase ou un token sk.* Mapbox.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAPBOX_ACCESS_TOKEN=pk.eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé API Anthropic pour l'identification d'espèces depuis photo (Claude Vision).
# Console : https://console.anthropic.com/settings/keys
# ⚠️ Cette clé est SECRÈTE (donne accès facturé à ton compte Anthropic) — JAMAIS la commit.
# Le bundle Android la contient (.env est asset Flutter), donc à terme il faudra
# proxifier les appels via une edge function Supabase. Pour MVP perso, OK.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
